# Goodwin Bricklaying — environment variables
# Copy to .env.local and fill in once the client supplies the values.
# All NEXT_PUBLIC_* values are exposed to the browser at build time.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to keep analytics fully disabled. When set, GA4 only loads
# after the visitor accepts analytics cookies in the consent banner.
NEXT_PUBLIC_GA_ID=

# Google Ads conversion ID (e.g. AW-XXXXXXXXX). Shares the single gtag.js
# loader with GA4 above and is gated by the same consent banner.
NEXT_PUBLIC_ADS_ID=

# Conversion action labels from Google Ads (Goals > Conversions > Summary >
# open the action > Tag setup). Each is the part after the slash in
# "AW-XXXXXXXXX/AbC-D_efGh". Blank means that conversion isn't reported.
# lead  = enquiry form submitted (fires on /thank-you)
# call  = click-to-call tap on any tel: link
NEXT_PUBLIC_ADS_LEAD_LABEL=
NEXT_PUBLIC_ADS_CALL_LABEL=
